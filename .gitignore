# Local snapshot dump dir (state_snapshot_*.db files for Mac-side cal_mlp drain).
# 0-byte placeholder state.db + multi-hundred-MB snapshots — never commit.
/data/
# R-p7-deploy-r11 R6: bot-runtime persistence dir (spot_buffer.json,
# external_poller_state.json). Local-only; never commit.
# R7 (LOW): leading slash anchors to repo root only — without it, any
# nested `tests/fixtures/state/` etc. would also be silently ignored.
/state/




# Ignore Smart Environment folder
.smart-env

# macOS Finder artifacts
.DS_Store
**/.DS_Store

# Claude Code session locks — transient, machine-local; iCloud Drive
# creates conflict copies (`scheduled_tasks 2.lock` etc.). Never commit.
.claude/scheduled_tasks*.lock

# Bit 1.1 (Sprint 1 modularization): tooling artifacts.
# `.ruff_cache/` is created by `ruff check`; `*.egg-info/` and `build/` by
# `pip install -e .`. All transient, machine-local — never commit.
# Leading `/` anchors to repo root so a nested `tests/fixtures/build/` or
# similar isn't silently ignored (per `R7 (LOW)` rationale above for /data/).
/.ruff_cache/
/*.egg-info/
/build/
# Defense in depth for tests/test_pyproject.py::test_extend_exclude_actually_excludes:
# the test drops `_ruff_exclude_probe_<pid>_<uuid>.py` into kb/, models/, etc.
# (most NOT gitignored) and relies on a finally-block to clean up. If pytest
# is killed mid-test, leak risk is real. This pattern guarantees stray probes
# never end up in a `git add -A` commit.
**/_ruff_exclude_probe_*.py
