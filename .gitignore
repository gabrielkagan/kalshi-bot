# Local snapshot dump dir (state_snapshot_*.db files for Mac-side cal_mlp drain).
# 0-byte placeholder state.db + multi-hundred-MB snapshots — never commit.
/data/
# R-p7-deploy-r11 R6: bot-runtime persistence dir (spot_buffer.json,
# external_poller_state.json). Local-only; never commit.
# R7 (LOW): leading slash anchors to repo root only — without it, any
# nested `tests/fixtures/state/` etc. would also be silently ignored.
/state/

# cal_mlp trained model bundles (~7MB total across 4 assets at v1 baseline).
# Local-only by convention — bundles ship to the VPS via deploy, not git.
# Re-sync from VPS with:
#   rsync -av botuser@<vps>:~/kalshi-bot-repo/models/ models/
# Leading `/` anchors to repo root only.
/models/




# Ignore Smart Environment folder
.smart-env

# macOS Finder artifacts
.DS_Store
**/.DS_Store

# Claude Code session locks — transient, machine-local; iCloud Drive
# creates conflict copies (`scheduled_tasks 2.lock` etc.). Never commit.
.claude/scheduled_tasks*.lock

# Sprint PSC Bit P5.1 — parallel-Claude-session lock primitive artifacts.
# `_session_lock.SessionLock` writes per-target lockfiles + tmp + quarantine
# sidecars + a reclaim audit log under .claude/locks/. All carry per-machine
# PIDs / session_ids / wall-clock heartbeats — pure runtime state, never
# meant for the repo. A `git add -A` or over-eager `git add .claude/` would
# otherwise commit machine-specific PIDs (self-defeating for a coordination
# primitive). Keep `.gitkeep` tracked so the dir survives a fresh clone.
# Leading `/` anchors to repo root (per /data/, /state/ rationale above).
/.claude/locks/active-work/*.lock
/.claude/locks/active-work/*.tmp.*
/.claude/locks/active-work/*.quarantine
/.claude/locks/reclaim.log

# Bit 1.1 (Sprint 1 modularization): tooling artifacts.
# `.ruff_cache/` is created by `ruff check`; `*.egg-info/` and `build/` by
# `pip install -e .`. All transient, machine-local — never commit.
# Leading `/` anchors to repo root so a nested `tests/fixtures/build/` or
# similar isn't silently ignored (per `R7 (LOW)` rationale above for /data/).
/.ruff_cache/
/*.egg-info/
/build/
# Defense in depth for tests/unit/test_pyproject.py::test_extend_exclude_actually_excludes:
# the test drops `_ruff_exclude_probe_<pid>_<uuid>.py` into kb/, models/, etc.
# (most NOT gitignored) and relies on a finally-block to clean up. If pytest
# is killed mid-test, leak risk is real. This pattern guarantees stray probes
# never end up in a `git add -A` commit.
**/_ruff_exclude_probe_*.py

# Pillar 3 (testing-foundation-sprint): hypothesis property-test cache
# (.hypothesis/constants etc. — per-machine state, not deterministic).
.hypothesis/

# Pillar 5 (testing-foundation-sprint): pytest-testmon cache + mutmut
# artifacts. All per-machine state, not deterministic across runs.
#   * `.testmondata` — testmon's per-test code-fingerprint database.
#     Without this gitignore, agents would commit it after every save
#     and CI would race-write it. Per-machine.
#   * `mutants/` — mutmut's per-mutant working dir (one subdir per
#     mutant; deleted between runs). Hundreds of MB during a baseline.
#   * `.mutmut-cache/` — mutmut 2.x results cache (used to skip
#     already-run mutants on incremental invocations).
.testmondata
/mutants/
.mutmut-cache/
# Ticket 86b9vgh1a — Pillar 5 lock sentinel. scripts/ops/_mutmut_lock.py
# opens this file with O_CREAT to anchor an fcntl.flock(LOCK_EX|LOCK_NB)
# guard so concurrent `make test-mutmut` / `test-equivalence` /
# `test-integration` invocations fail-fast (instead of racing on
# mutmut's in-place mutation of bot/engines/). Anchored to repo root
# only via leading `/` (per /data/, /state/ rationale above) — a
# nested test fixture's `.mutmut.lock` won't be silently ignored.
/.mutmut.lock

# iCloud Drive sync conflict copies — anything inside this repo's tree
# that lives under iCloud will spawn `* 2.py`, `* 2.md`, `* 2/` siblings
# whenever two machines edit concurrently. They are NEVER intentional;
# pytest collection picks them up and double-runs every test, snapshot
# regen races on whichever-was-cached-first, and the merge commit
# carries dozens of duplicates. Match the literal " 2" suffix only —
# narrow enough to not catch legitimate filenames that happen to contain
# spaces or the digit "2".
**/*\ 2.py
**/*\ 2.md
**/*\ 2.csv
**/*\ 2.yml
**/*\ 2.yaml
**/*\ 2.json
**/*\ 2.txt
**/*\ 2.parquet
**/*\ 2.sql
**/*\ 2.toml
**/*\ 2.lock
**/*\ 2.sh
**/*\ 2/

# Sprint 14 A5 (ticket 86b9zf7cc): transient per-Bit scratch directories.
#   * `/.p*_run/` — operator/agent scratch dirs from prior pickup-bit runs
#     (e.g. .p0_2_run/, .p1_2_run/, .p2_1_b_run/). Per-machine; never
#     intentional in a commit.
#   * `/.claude/worktrees/` — claude-code agent worktree mountpoints. Per
#     -machine and may contain partial checkouts.
# Leading `/` anchors to repo root only (per /data/, /state/ rationale above).
/.p*_run/
/.claude/worktrees/
