# Pillar 2 of the testing-foundation-sprint (parent ticket 86b9ve0wa,
# this Bit 86b9ve0yt). Declares structural import-layer contracts that
# import-linter enforces in CI via the `lint-imports` step in
# .github/workflows/test.yml + deploy.yml. Contracts intentionally
# reflect REALITY on current main, not aspirations — running
# `lint-imports` from the repo root must pass on the commit that
# ships this file.
#
# Each contract uses the `forbidden` type (source_modules cannot reach
# forbidden_modules in the import graph). grimp resolves the package
# tree from `root_package = bot` below.
#
# AC item "No module imports `from bot._impl import *`" is enforced
# separately by tests/test_no_impl_star_import.py — import-linter sees
# star imports as regular imports of the source module, indistinguishable
# from `import bot._impl` for graph purposes, so the wildcard ban needs
# AST-level detection.

[importlinter]
root_package = bot

# ---------------------------------------------------------------------------
# Contract 1 — engines must not import bot._impl
# ---------------------------------------------------------------------------
# Sprint 6 (Bits 6.1 + 6.2 + 6.3) extracted VolatilityEngine,
# ProbabilityEngine, and CalibrationEngine into bot/engines/. The intent
# is that engines depend DOWN on bot.{constants, helpers, feeds, fetchers}
# but never UP into bot._impl (which would re-create the circular load
# that the extractions resolved).
#
# Bit 6.2 originally introduced a carve-out
# (`ignore_imports = bot.engines.probability -> bot._impl`) because
# probability.py used a late-binding `from bot import _impl as _bot_impl`
# pattern to access the mutable `_CALIBRATION_ENGINE` singleton and
# `_resolve_cal_engine` function (both defined in bot/_impl.py below the
# line-109 engines re-export — top-level import would have ImportErrored
# or captured a stale `None`).
#
# Bit 6.3 path-B (2026-05-10) RELOCATED `_CALIBRATION_ENGINE` +
# `_CAL_REGISTRY` + `_derive_subtype` + `_derive_asset_filter` +
# `_resolve_cal_engine` from bot/_impl.py to bot/engines/calibration.py
# (where the class itself was already moving). Both bot/_impl.py and
# bot/engines/probability.py now reach them via top-level
# `from bot.engines import calibration as _cal_state` plus
# `_cal_state.X` attribute access. The late-binding is gone; the
# carve-out below is gone with it.
[importlinter:contract:engines-no-impl]
name = bot.engines.* must not import bot._impl (Bit 6.3 path-B lifted the Bit 6.2 carve-out)
type = forbidden
source_modules =
    bot.engines
forbidden_modules =
    bot._impl

# ---------------------------------------------------------------------------
# Contract 2 — fetchers must not import engines
# ---------------------------------------------------------------------------
# Bit 4.4 extracted DeribitDVOLFetcher + CoinGlassFetcher to bot/fetchers/.
# Engines (Sprint 6) consume fetcher output — the dependency arrow is
# engines → fetchers, never the reverse. A fetcher reaching into engines
# would invert the layering and re-introduce a load cycle.
[importlinter:contract:fetchers-no-engines]
name = bot.fetchers.* must not import bot.engines.*
type = forbidden
source_modules =
    bot.fetchers
forbidden_modules =
    bot.engines

# ---------------------------------------------------------------------------
# Contract 3 — feeds must not import engines
# ---------------------------------------------------------------------------
# Bit 4.5a + 4.5b extracted CoinbaseFeed/CrossExchangeFeed/KalshiFeed to
# bot/feeds/. Same direction rule as fetchers: engines consume feed output.
# Sibling intra-package imports inside bot/feeds/ (e.g., cross_exchange
# importing CoinbaseFeed, kalshi importing OrderbookSchemaError) are
# allowed because forbidden_modules does not list bot.feeds.
[importlinter:contract:feeds-no-engines]
name = bot.feeds.* must not import bot.engines.*
type = forbidden
source_modules =
    bot.feeds
forbidden_modules =
    bot.engines

# ---------------------------------------------------------------------------
# Contract 4 — helpers leaf rule
# ---------------------------------------------------------------------------
# Bit 3.2 extracted bot/helpers/ as the leaf-most subpackage: helpers
# depend ONLY on bot.constants (and external stdlib/third-party deps).
# Helpers may also re-export sibling helpers via
# `from bot.helpers.<sub> import *` inside bot/helpers/__init__.py
# (intra-package, not flagged because forbidden_modules does not list
# bot.helpers).
#
# IMPORTANT — implementation note: import-linter's `forbidden` contract
# is enumerate-the-deny-list, NOT enforce-the-allow-list. Anything not
# explicitly listed in forbidden_modules below is implicitly allowed.
# To prevent silent drift (Sprint 7+ ships a new top-level bot/ module
# someone forgets to append here, and helpers gain a back-edge to it),
# tests/contracts/test_import_linter_contracts.py::test_helpers_leaf_
# forbidden_modules_covers_all_bot_top_level walks bot/ at test time
# and asserts every top-level module/subpackage besides bot.helpers
# (the source) and bot.constants (the only allowed leaf dep) is listed
# below. New top-level bot/ entries fail the regression test until
# appended here in the same Bit that creates them.
[importlinter:contract:helpers-leaf]
name = bot.helpers.* may not import sibling subpackages or bot._impl (leaf rule)
type = forbidden
source_modules =
    bot.helpers
forbidden_modules =
    bot._impl
    bot._thread_env
    bot.engines
    bot.executor
    bot.feeds
    bot.fetchers
    bot.main_loop
    bot.order_flow
    bot.orphan_db_watchdog
    bot.scanner
    bot.clients
    bot.kalshi_client
    bot.logger
    bot.notifier
    bot.db_writer_registry
    bot.settlement
    bot.state

# ---------------------------------------------------------------------------
# Contract 5 — bot.state must not have a top-level import of bot._impl
# ---------------------------------------------------------------------------
# Bit 7.1 (790214f, 2026-05-10) extracted StateManager from bot/_impl.py to
# bot/state.py via path-A++. The two `globals()` call sites inside
# StateManager.__init__ pre-extraction resolved to bot._impl's namespace,
# laundered via `from config import *` + `from bot.constants import *` +
# `from bot.helpers import *` at the top of bot/_impl.py. Path-A++
# refactored parity_assert / sizing_parity_assert in
# scripts/cal_mlp/integration.py to drop the bot_globals param; bot/state.py
# uses a single-name method-body late-binding helper
# `_get_compute_for_15m_main_path()` (search anchor:
# `def _get_compute_for_15m_main_path` in bot/state.py) to reach
# `bot._impl.compute_for_15m_main_path` (bound below the bot.state
# re-export inside bot/_impl.py — search anchor:
# `from bot.state import StateManager`). A top-level import would either
# ImportError on the partial module or capture the closure stale.
#
# import-linter's grimp graph does NOT distinguish module-level from
# function-body imports. The `ignore_imports` directive below removes the
# `bot.state -> bot._impl` edge entirely from the graph; the contract
# alone cannot prevent a regression to top-level import. The actual
# anti-regression seal is three-layer:
#   1. tests/test_state_extraction.py::test_state_no_top_level_bot_impl_import
#      — original Bit 7.1 AST pin at the extraction-test layer
#   2. tests/contracts/test_import_linter_contracts.py::
#      test_state_no_toplevel_bot_impl_import_at_contract_layer
#      — peer AST pin at the contract-test layer
#   3. tests/contracts/test_import_linter_contracts.py::
#      test_lint_imports_fails_when_state_carve_out_removed
#      — load-bearing test that mutates this file (configparser-removes
#      the ignore_imports line) and asserts lint-imports fails; locks
#      the carve-out config against accidental removal
# This contract block makes the carve-out auditable in `.importlinter`
# itself — a future maintainer scanning the file sees that the
# bot.state → bot._impl edge is "managed" rather than "missing".
#
# The carve-out is permanent until the load-order cycle is structurally
# redesigned (e.g., compute_for_15m_main_path lifted to its own module
# above the bot.state re-export line). Bit 7.1 closeout
# (kb/decisions/bit-7.1-shipped-may10.md § Code-smell follow-ups) tracks
# the wider make_compute_for_15m_main_path closure smell as a Sprint 8
# candidate; until that lifts the cycle, the carve-out stays.
[importlinter:contract:state-no-impl-toplevel]
name = bot.state must not have a top-level import of bot._impl (method-body late-binding allowed)
type = forbidden
source_modules =
    bot.state
forbidden_modules =
    bot._impl
ignore_imports =
    bot.state -> bot._impl

# ---------------------------------------------------------------------------
# Contract 6 (RETIRED Bit 9.1, 2026-05-10) — `scanner-no-impl-toplevel`
# ---------------------------------------------------------------------------
# Sprint 9 Bit 9.1 extracted OrderExecutor from bot/_impl.py to bot/executor.py.
# bot/scanner/__init__.py now uses a top-level `from bot.executor import
# OrderExecutor` directly — the `_get_order_executor()` late-binding helper
# retired in the same atomic commit, and this `scanner-no-impl-toplevel`
# contract block dropped with it. Net contract count: 6 → 5.
#
# Path-A++ relocation of `_append_raw_api_journal` to bot/helpers/raw_api_journal.py
# in the same Bit means no `executor-no-impl-toplevel` carve-out is needed
# either — bot/executor.py has zero references into bot._impl.
#
# Bit 8.1 fu1 (commit 5bfc116-shape) peer-pin tests in
# tests/contracts/test_import_linter_contracts.py also dropped in the same
# Bit-9.1 commit, with `scanner-no-impl-toplevel` removed from EXPECTED_CONTRACTS.
