# Pillar 2 of the testing-foundation-sprint (parent ticket 86b9ve0wa,
# this Bit 86b9ve0yt). Declares structural import-layer contracts that
# import-linter enforces in CI via the `lint-imports` step in
# .github/workflows/test.yml + deploy.yml. Contracts intentionally
# reflect REALITY on current main, not aspirations — running
# `lint-imports` from the repo root must pass on the commit that
# ships this file.
#
# Each contract uses the `forbidden` type (source_modules cannot reach
# forbidden_modules in the import graph). grimp resolves the package
# tree from `root_package = bot` below.
#
# AC item "No module imports `from bot._impl import *`" is enforced
# separately by tests/contracts/test_no_impl_star_import.py — import-linter sees
# star imports as regular imports of the source module, indistinguishable
# from `import bot._impl` for graph purposes, so the wildcard ban needs
# AST-level detection.

[importlinter]
root_package = bot
# Bit 12.3 (Sprint 12, 2026-05-11): required for the bot-no-torch
# and bot-no-pandas contracts, which name EXTERNAL packages (torch,
# pandas) as forbidden_modules. Without this flag, import-linter
# refuses to load the config: "The top level configuration must
# have include_external_packages=True when there are external
# forbidden modules." grimp's external-package scan adds a small
# import-graph build cost but is negligible (<1s on this repo).
include_external_packages = True

# ---------------------------------------------------------------------------
# Contract 1 (RETIRED Bit 9.3-iii.c, 2026-05-11) — `engines-no-impl`
# ---------------------------------------------------------------------------
# Sprint 6 (Bits 6.1 + 6.2 + 6.3) extracted VolatilityEngine,
# ProbabilityEngine, and CalibrationEngine into bot/engines/. The original
# `engines-no-impl` contract forbade bot.engines.* from reaching
# bot._impl — a load-cycle anti-regression seal.
#
# Bit 6.2 originally shipped with a carve-out
# `ignore_imports = bot.engines.probability -> bot._impl` for the
# late-binding access to `_CALIBRATION_ENGINE` and `_resolve_cal_engine`.
# Bit 6.3 path-B (2026-05-10) RELOCATED those names out of bot/_impl.py
# into bot/engines/calibration.py — the carve-out was lifted in the same
# atomic commit, leaving only `bot._impl` in `forbidden_modules`.
#
# Bit 9.3-iii.c (2026-05-11) DELETED bot/_impl.py entirely. The
# `engines-no-impl` contract is now vacuous (`forbidden_modules` would be
# empty, which import-linter rejects as malformed). The contract is
# RETIRED here. The anti-regression seal moves to
# `tests/integration/test_bit_9_3_iii_c_impl_deletion.py::test_bot_impl_py_file_absent`
# + `test_bot_impl_module_import_fails` — if bot/_impl.py is ever
# re-created, those AST/import pins fail loudly. The original
# `bot.engines.* must not import bot._impl` claim is stronger now: NO
# module can import bot._impl because the module doesn't exist.

# ---------------------------------------------------------------------------
# Contract 2 — fetchers must not import engines
# ---------------------------------------------------------------------------
# Bit 4.4 extracted DeribitDVOLFetcher + CoinGlassFetcher to bot/fetchers/.
# Engines (Sprint 6) consume fetcher output — the dependency arrow is
# engines → fetchers, never the reverse. A fetcher reaching into engines
# would invert the layering and re-introduce a load cycle.
[importlinter:contract:fetchers-no-engines]
name = bot.fetchers.* must not import bot.engines.*
type = forbidden
source_modules =
    bot.fetchers
forbidden_modules =
    bot.engines

# ---------------------------------------------------------------------------
# Contract 3 — feeds must not import engines
# ---------------------------------------------------------------------------
# Bit 4.5a + 4.5b extracted CoinbaseFeed/CrossExchangeFeed/KalshiFeed to
# bot/feeds/. Same direction rule as fetchers: engines consume feed output.
# Sibling intra-package imports inside bot/feeds/ (e.g., cross_exchange
# importing CoinbaseFeed, kalshi importing OrderbookSchemaError) are
# allowed because forbidden_modules does not list bot.feeds.
[importlinter:contract:feeds-no-engines]
name = bot.feeds.* must not import bot.engines.*
type = forbidden
source_modules =
    bot.feeds
forbidden_modules =
    bot.engines

# ---------------------------------------------------------------------------
# Contract 4 — helpers leaf rule
# ---------------------------------------------------------------------------
# Bit 3.2 extracted bot/helpers/ as the leaf-most subpackage: helpers
# depend ONLY on bot.constants (and external stdlib/third-party deps).
# Helpers may also re-export sibling helpers via
# `from bot.helpers.<sub> import *` inside bot/helpers/__init__.py
# (intra-package, not flagged because forbidden_modules does not list
# bot.helpers).
#
# IMPORTANT — implementation note: import-linter's `forbidden` contract
# is enumerate-the-deny-list, NOT enforce-the-allow-list. Anything not
# explicitly listed in forbidden_modules below is implicitly allowed.
# To prevent silent drift (Sprint 7+ ships a new top-level bot/ module
# someone forgets to append here, and helpers gain a back-edge to it),
# tests/contracts/test_import_linter_contracts.py::test_helpers_leaf_
# forbidden_modules_covers_all_bot_top_level walks bot/ at test time
# and asserts every top-level module/subpackage besides bot.helpers
# (the source) and bot.constants (the only allowed leaf dep) is listed
# below. New top-level bot/ entries fail the regression test until
# appended here in the same Bit that creates them.
[importlinter:contract:helpers-leaf]
name = bot.helpers.* may not import sibling subpackages (leaf rule)
type = forbidden
source_modules =
    bot.helpers
forbidden_modules =
    bot._thread_env
    bot.boot
    bot.engines
    bot.executor
    bot.feeds
    bot.fetchers
    bot.main_loop
    bot.infra
    bot.models
    bot.order_flow
    bot.orphan_db_watchdog
    bot.runtime_config
    bot.scanner
    bot.shadows
    bot.clients
    bot.kalshi_client
    bot.logger
    bot.notifier
    bot.db_writer_registry
    bot.settlement
    bot.state
ignore_imports =
    # Sprint 10.5a (2026-05-11): bot.helpers.breakers reaches the circuit-breaker
    # REGISTRY singleton via a wrapper-internal lazy import (search anchor in
    # bot/helpers/breakers.py: `def _kalshi_breaker` → `from bot.infra.circuit_breaker
    # import REGISTRY`). Pre-10.5a circuit_breaker.py was at repo root (not a
    # `bot.X` subpackage) so the helpers-leaf rule didn't apply; post-10.5a it
    # lives at bot.infra.circuit_breaker (sibling). Per Bit 7.1
    # `state-no-impl-toplevel` precedent: import-linter's `forbidden` contract
    # doesn't distinguish module-level from method-body imports, so a carve-out
    # is required. The lazy import is the only edge — verified via AST walk in
    # tests/integration/test_sprint_10_5a_infra_move.py.
    bot.helpers.breakers -> bot.infra.circuit_breaker
    # Sprint 10.5b (2026-05-11): bot.helpers.tm_sweep reaches calculate_taker_fee
    # via a function-scoped lazy import in `_get_calculate_taker_fee()`
    # (search anchor in bot/helpers/tm_sweep.py: `def _get_calculate_taker_fee`).
    # Pre-10.5b models.py was at repo root; post-10.5b it lives at bot.models
    # (sibling). Same Bit 7.1 / Sprint 10.5a carve-out pattern as breakers above.
    bot.helpers.tm_sweep -> bot.models

# ---------------------------------------------------------------------------
# Contract 5 (RETIRED Bit 9.3-iii.a, 2026-05-11) — `state-no-impl-toplevel`
# ---------------------------------------------------------------------------
# Bit 7.1 (790214f, 2026-05-10) introduced this carve-out because
# bot/state.py needed late-binding access to `bot._impl.compute_for_15m_main_path`
# via the `_get_compute_for_15m_main_path()` helper. The closure was bound
# below the bot.state re-export inside bot/_impl.py — a top-level import
# would have hit partial-module ImportError or captured a stale binding.
#
# Bit 9.3-iii.a (2026-05-11) STRUCTURALLY redesigned the load order per the
# Bit 7.1 closeout § "Code-smell follow-ups": `compute_for_15m_main_path` was
# relocated to NEW clean-leaf `bot/boot.py` (zero bot.state edges), and
# bot/state.py now top-imports it directly. The `_get_compute_for_15m_main_path()`
# helper retired in the same atomic commit. bot/state.py has ZERO bot._impl
# edges post-9.3-iii.a, so the carve-out is no longer needed and is REMOVED.
#
# The 3 anti-regression tests (test_state_no_top_level_bot_impl_import,
# test_state_no_toplevel_bot_impl_import_at_contract_layer,
# test_lint_imports_fails_when_state_carve_out_removed) were retired in the
# same atomic commit. test_state_has_zero_bot_impl_edges in
# tests/integration/test_bit_9_3_iii_a_boot_relocation.py replaces them with the stronger
# claim: bot.state has zero bot._impl references, not just no top-level import.

# ---------------------------------------------------------------------------
# Contract 5 (renumbered from 6 post-Bit-9.3-iii.a) — bot.* must not import
# torch directly
# ---------------------------------------------------------------------------
# Per CLAUDE.md sacred rule: "Don't import torch directly in
# bot/_impl.py. cal_mlp is the single torch entry point via
# scripts/cal_mlp/integration.py, which constrains threads at
# module-import time." numpy/scipy/torch C-extensions cache OpenBLAS
# thread count at load time, so OMP_NUM_THREADS=1 must be set BEFORE
# torch imports. The bot._thread_env-pinned chain (bot/__main__.py →
# bot._thread_env → ...) is the load-order guarantee; a direct
# `import torch` anywhere under bot/ would route around it.
#
# Postmortem: production incident 2026-04-29 (scan loop ballooned to
# 7.75s, 0 candidates in 5min) → kb/failures/cal-mlp-torch-thread-
# contention-apr29.md. AST regression in
# tests/integration/test_cal_mlp_invariants.py::test_thread_env_imported_before_
# numerical_libs_in_bot_impl guards bot/_impl.py specifically; this
# contract generalizes to ALL bot.* modules. torch is reachable
# transitively via scripts/cal_mlp/integration.py (NOT under bot/), so
# the contract correctly allows that path. Bit 12.3 (Sprint 12,
# 2026-05-11).
[importlinter:contract:bot-no-torch]
name = bot.* must not import torch directly (cal_mlp/integration.py is the single torch entry point)
type = forbidden
source_modules =
    bot
forbidden_modules =
    torch

# ---------------------------------------------------------------------------
# Contract 6 (renumbered from 7 post-Bit-9.3-iii.a) — bot.* must not import
# pandas directly
# ---------------------------------------------------------------------------
# Same rationale as bot-no-torch: pandas C-extensions also cache
# OpenBLAS thread count at load time. scripts/cal_mlp/integration.py
# is the canonical chokepoint that ensures the bot._thread_env-pinned
# chain holds. A direct `import pandas` anywhere under bot/ would
# defeat the contention fix from the 2026-04-29 incident.
# Bit 12.3 (Sprint 12, 2026-05-11).
[importlinter:contract:bot-no-pandas]
name = bot.* must not import pandas directly (same load-order concern as torch)
type = forbidden
source_modules =
    bot
forbidden_modules =
    pandas

# ---------------------------------------------------------------------------
# Contract 8 (RETIRED Bit 9.1, 2026-05-10) — `scanner-no-impl-toplevel`
# ---------------------------------------------------------------------------
# Sprint 9 Bit 9.1 extracted OrderExecutor from bot/_impl.py to bot/executor.py.
# bot/scanner/__init__.py now uses a top-level `from bot.executor import
# OrderExecutor` directly — the `_get_order_executor()` late-binding helper
# retired in the same atomic commit, and this `scanner-no-impl-toplevel`
# contract block dropped with it. Net contract count: 6 → 5.
#
# Path-A++ relocation of `_append_raw_api_journal` to bot/helpers/raw_api_journal.py
# in the same Bit means no `executor-no-impl-toplevel` carve-out is needed
# either — bot/executor.py has zero references into bot._impl.
#
# Bit 8.1 fu1 (commit 5bfc116-shape) peer-pin tests in
# tests/contracts/test_import_linter_contracts.py also dropped in the same
# Bit-9.1 commit, with `scanner-no-impl-toplevel` removed from EXPECTED_CONTRACTS.
