[Unit]
Description=Kalshi Coinbase Bronze Collector (D2.5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/kalshi-bot-repo
EnvironmentFile=/home/botuser/.env.coinbase-collector
ExecStart=/home/botuser/kalshi-bot-repo/coinbase-collector-start.sh
Restart=on-failure
RestartSec=10s

# D2.5 isolation knobs — load-bearing structural bounds on the
# Coinbase collector blast radius (NOT documentation suggestions).
# Pinned by tests/contracts/test_kalshi_coinbase_collector_systemd_unit.py;
# a future edit that loosens any of these must update the test in the
# same commit (and update kb/decisions/data-corpus-architecture.md §6).
#
# Deltas vs kalshi-collector.service (D1.5):
#   - NO CPUAffinity (same posture as kalshi-collector post-retirement
#     2026-05-19 ticket 86ba12rv6). The kernel scheduler floats both
#     this unit and kalshi-collector across both vCPUs; Nice=10 +
#     MemoryMax are the load-bearing isolation knobs. Coinbase
#     single-conn light load is fine on either vCPU.
#   - MemoryMax=384M (Kalshi: 512M). Coinbase single-conn × 9 products
#     × 5 channels (post-D2.5 level2_batch promotion; ADA+BCH added
#     2026-05-30 for the 9-asset corpus) is structurally lighter than
#     Kalshi 7-conn × ~21K-subs. Bumped 256M→384M: measured peak was
#     229M/256M (90%) at 7 products; 9 products project to ~295M, so 384M
#     restores headroom. Host has 5.4G free (per-unit cap is the only
#     constraint).
#   - LimitNOFILE=512 (Kalshi: 4096). 1 conn × 5 channels × rotation +
#     rclone needs ~30 fd typical; 512 is ~10× headroom.
#
# Same as kalshi-collector.service:
Nice=10
MemoryMax=384M
MemorySwapMax=0
LimitNOFILE=512

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
