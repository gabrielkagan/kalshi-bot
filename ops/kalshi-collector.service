[Unit]
Description=Kalshi Data Corpus Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/kalshi-bot-repo
EnvironmentFile=/home/botuser/.env.collector
ExecStart=/home/botuser/kalshi-bot-repo/collector-start.sh
Restart=on-failure
RestartSec=10s

# D0.3 §6 isolation knobs — load-bearing structural bounds on
# collector blast radius (NOT documentation suggestions). Pinned by
# tests/contracts/test_kalshi_collector_systemd_unit.py; a future
# edit that loosens any of these must update the test in the same
# commit (and update kb/decisions/data-corpus-architecture.md §6).
#
# CPUAffinity RETIRED 2026-05-19 (ticket 86ba12rv6, umbrella 86ba12rf0):
# at 754K+ tickers the single-vCPU pin saturated at 90% CPU on 1 core
# while vCPU-0 sat idle, driving ~33% sustained frame drop. The Nice=10
# polite-background posture remains the load-bearing guarantee that bot
# scan latency cannot be starved by the collector; the kernel scheduler
# now floats both processes across both vCPUs. See
# kb/decisions/collector-queue-saturation-fix-plan.md for RCA.
Nice=10
# MemoryHigh=400M (78% of MemoryMax) — soft cgroup throttle that logs a
# pressure warning + slows the collector via kernel throttling BEFORE
# the hard MemoryMax=512M SIGKILL. Pinned by
# tests/contracts/test_kalshi_collector_systemd_unit.py.
# Added 2026-05-20 (umbrella 86ba12rf0): the 2026-05-19 unexplained
# collector exits at 22:06 / 22:26 / 00:04 UTC correlated with peak
# memory at 472M / 512M (92%) — possible kernel OOM cascade from
# combined bot+collector memory pressure on the 2GB VPS. MemoryHigh
# fires a soft warning at 400M that surfaces in cgroup pressure
# counters BEFORE the hard kill.
MemoryHigh=400M
MemoryMax=512M
MemorySwapMax=0
LimitNOFILE=4096

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
