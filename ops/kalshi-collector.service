[Unit]
Description=Kalshi Data Corpus Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/kalshi-bot-repo
EnvironmentFile=/home/botuser/.env.collector
ExecStart=/home/botuser/kalshi-bot-repo/collector-start.sh
Restart=on-failure
RestartSec=10s

# D0.3 §6 isolation knobs — load-bearing structural bounds on
# collector blast radius (NOT documentation suggestions). Pinned by
# tests/contracts/test_kalshi_collector_systemd_unit.py; a future
# edit that loosens any of these must update the test in the same
# commit (and update kb/decisions/data-corpus-architecture.md §6).
#
# CPUAffinity RETIRED 2026-05-19 (ticket 86ba12rv6, umbrella 86ba12rf0):
# at 754K+ tickers the single-vCPU pin saturated at 90% CPU on 1 core
# while vCPU-0 sat idle, driving ~33% sustained frame drop. The Nice=10
# polite-background posture remains the load-bearing guarantee that bot
# scan latency cannot be starved by the collector; the kernel scheduler
# now floats both processes across both vCPUs. See
# kb/decisions/collector-queue-saturation-fix-plan.md for RCA.
Nice=10
# MemoryHigh=1600M (78% of MemoryMax) — soft cgroup throttle that logs a
# pressure warning + slows the collector via kernel throttling BEFORE
# the hard MemoryMax=2048M SIGKILL. Pinned by
# tests/contracts/test_kalshi_collector_systemd_unit.py.
# Originally added 2026-05-20 (umbrella 86ba12rf0) at 400M for the 2GB
# VPS; raised to 1600M same day (ticket 86ba1h0cb) in lockstep with
# the MemoryMax 512M → 2048M raise and the droplet resize from
# s-2vcpu-2gb → s-4vcpu-8gb. Preserves the 78% ratio so the soft
# throttle still fires meaningfully ahead of the hard kill.
MemoryHigh=1600M
# MemoryMax=2048M — raised from 512M on 2026-05-20 (ticket 86ba1h0cb)
# in lockstep with the s-2vcpu-2gb → s-4vcpu-8gb droplet resize. The
# 512M cap was sized against D0.2 §3.2's 47 MB/conn × 7-8 conns ≈
# 376 MB Python footprint on the 2GB box. Post-resize universe growth
# (705K tickers measured 2026-05-20, vs the runbook's 386K estimate)
# pushed peak cgroup memory to 513M during the universal-mode boot,
# crossing the prior 512M cap. The 2048M cap on the 8GB box leaves
# ~5.5GB physical headroom even with bot + all 4 collectors at cap.
MemoryMax=2048M
MemorySwapMax=0
LimitNOFILE=4096

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
